{% extends 'base.html.twig' %}

{% block title %}Contact — Côté Montagne, décoration d'intérieur à Saint-Lary-Soulan{% endblock %}
{% block description %}Contactez Côté Montagne pour votre projet de décoration ou d'aménagement à Saint-Lary-Soulan : téléphone, e-mail, adresse et horaires des boutiques.{% endblock %}

{% block body %}
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Contact</span>
    <h1>Racontez-nous votre projet</h1>
    <p class="lead">Appelez-nous, écrivez-nous ou passez en boutique. Nous revenons vers vous rapidement pour fixer un premier rendez-vous.</p>
  </div>
</section>

<section class="section">
  <div class="container cards-2">
    <div class="info-card" data-reveal>
      <span class="eyebrow">Téléphone</span>
      <h3><a href="tel:+33562402335">05 62 40 23 35</a></h3>
      <p>Studio et boutique Côté Montagne. Horaires variables selon la saison.</p>
    </div>
    <div class="info-card" data-reveal>
      <span class="eyebrow">E-mail</span>
      <h3><a href="mailto:contact@cote-montagne.fr">contact@cote-montagne.fr</a></h3>
      <p>Joignez quelques photos ou plans de votre lieu si vous en avez.</p>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Nos boutiques</h2>
    </div>
    {{ include('page/_shop_cards.html.twig') }}
  </div>
</section>
{% endblock %}
