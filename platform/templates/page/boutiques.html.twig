{% extends 'base.html.twig' %}

{% block title %}Nos boutiques — Côté Montagne et L'Écrin à Saint-Lary-Soulan{% endblock %}
{% block description %}Nos deux boutiques rue Vincent Mir à Saint-Lary-Soulan : Côté Montagne pour la décoration et l'ameublement montagne, L'Écrin pour les cadeaux et souvenirs. Adresses et horaires.{% endblock %}

{% block body %}
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Nos boutiques</span>
    <h1>Deux adresses rue Vincent Mir</h1>
    <p class="lead">Au cœur du village de Saint-Lary-Soulan, à quelques pas l'une de l'autre : Côté Montagne pour meubler et décorer, L'Écrin pour offrir et se souvenir.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ include('page/_shop_cards.html.twig') }}
  </div>
</section>

<section class="section section-soft">
  <div class="container split">
    <div data-reveal>
      <span class="eyebrow">Studio & boutique</span>
      <h2>La boutique prolonge nos projets</h2>
      <p>Les pièces exposées chez Côté Montagne sont celles que nous utilisons dans nos aménagements. Vous pouvez les voir, les toucher, et les retrouver dans le devis de votre projet.</p>
      <a class="link-arrow" href="{{ path('prestations') }}">Découvrir nos prestations <span aria-hidden="true">→</span></a>
    </div>
    <div class="split-visual" data-reveal>Photo à venir · la boutique</div>
  </div>
</section>

{{ include('page/_cta.html.twig') }}
{% endblock %}
