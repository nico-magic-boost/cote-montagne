{% extends 'base.html.twig' %}

{% block title %}À propos — Charlène & Thibault, Côté Montagne à Saint-Lary-Soulan{% endblock %}
{% block description %}Côté Montagne, studio de décoration et deux boutiques à Saint-Lary-Soulan, fondés par Charlène et Thibault.{% endblock %}

{% block body %}
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">À propos</span>
    <h1>Une histoire de montagne et de maisons</h1>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split-visual" data-reveal>Photo à venir · Charlène & Thibault</div>
    <div data-reveal>
      <h2>Charlène & Thibault</h2>
      <p>Côté Montagne est né à Saint-Lary-Soulan d'une conviction : un intérieur réussi raconte le lieu où il se trouve. Bois, laine, pierre et lumière des sommets guident chacun de nos projets.</p>
      <p>Charlène imagine les intérieurs, de la première esquisse aux vues 3D. Thibault pilote les projets, les commandes et les artisans, pour que tout arrive au bon moment.</p>
      <p>Dans nos deux boutiques, Côté Montagne et L'Écrin, vous retrouvez les pièces que nous aimons utiliser dans nos projets.</p>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container cards-2">
    <div class="info-card" data-reveal>
      <h3>Côté Montagne</h3>
      <p>Mobilier, luminaires, linge de maison et décoration.</p>
      <p>43 rue Vincent Mir, 65170 Saint-Lary-Soulan</p>
    </div>
    <div class="info-card" data-reveal>
      <h3>L'Écrin</h3>
      <p>Cadeaux, senteurs et souvenirs des Pyrénées.</p>
      <p>Rue Vincent Mir, 65170 Saint-Lary-Soulan</p>
    </div>
  </div>
</section>

{{ include('page/_cta.html.twig') }}
{% endblock %}
